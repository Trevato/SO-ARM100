#!/usr/bin/env node
// Node, not Bun: serialport's native bindings call uv_default_loop, which Bun
// does not provide yet (https://github.com/oven-sh/bun/issues/18546). Bun still
// installs and tests the package; Node 24 strips the types at load time.
import { main } from "../src/cli.ts";

process.exitCode = await main(process.argv.slice(2));
